# Read-only RPC used by the browser. Falls back to the endpoint in config/mainnet.json.
NEXT_PUBLIC_RPC_URL=

# --- service thresholds (display only) ---
#
# These gate NOTHING. Auto-claim works at any size, the contract has no minimum,
# and no button is disabled because of them. They only decide whether a position
# is told it will be claimed on the regular schedule or once enough has
# accrued. Lower them to exercise a small position end to end on mainnet.
#
#   NEXT_PUBLIC_SERVICE_MIN_USD=1
#   NEXT_PUBLIC_SERVICE_MIN_BTC=0.00001
#   NEXT_PUBLIC_SERVICE_MIN_STRK=1
NEXT_PUBLIC_SERVICE_MIN_USD=
NEXT_PUBLIC_SERVICE_MIN_BTC=
NEXT_PUBLIC_SERVICE_MIN_STRK=

# --- keeper only, never exposed to the browser ---

# RPC the scheduled run uses.
RPC_URL=

# The account that sends claim transactions. It pays gas and nothing else:
# handlers only ever pay their own delegator, so this key cannot take funds.
KEEPER_ADDRESS=
KEEPER_PRIVATE_KEY=

# Vercel sends this as `Authorization: Bearer <secret>` on scheduled runs.
# Without it set, the route refuses to run in production.
CRON_SECRET=
